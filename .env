# .env

# URL para el changelog (opcional, puede quedar vacío)
CHANGELOG_URL=

# Habilita funciones inestables (false para mayor estabilidad)
ENABLE_NEW_SETTING_UNSTABLE_API=false

# Habilitar captcha en la aplicación (false para desactivar)
ENABLE_CAPTCHA=false

# Clave pública para CAPTCHA (dejamos vacío porque no se usa CAPTCHA)
CAPTCHA_SITE_KEY=

# Habilita modo de compartición mejorado (true o false según lo necesites)
ENABLE_ENHANCE_SHARE_MODE=false

# Permitir espacios de trabajo locales (true para uso local sin sincronización en la nube)
ALLOW_LOCAL_WORKSPACE=true

# Depuración de jotai (false para desactivar depuración)
DEBUG_JOTAI=false

# Configuración de la base de datos PostgreSQL
DATABASE_URL=postgres://affine:affine@localhost:5432/affine

# Configuración del servidor Redis
REDIS_SERVER_HOST=localhost
REDIS_SERVER_PORT=6379
REDIS_SERVER_USER=default
REDIS_SERVER_PASSWORD=tu_contraseña_de_redis

# Configuración del servidor de correo MailHog
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USER=
MAILER_PASSWORD=
MAILER_SENDER=affine@example.com
